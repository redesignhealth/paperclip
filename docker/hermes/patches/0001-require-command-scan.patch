+def _validate_mandatory_scanner(scanner_path: str | None) -> tuple[bool, str]:
+    """Validate scanner binary per-call:
+    - Path must be configured and absolute.
+    - Architecture must be Linux x86_64.
+    - Scanner must be a regular non-symlink file owned by root (uid 0), not group/world writable, executable.
+    - Parent directories up to '/' must be root-owned and not group/world writable.
+    """
+    if not scanner_path:
+        return False, "scanner_not_configured"
+
+    # Architecture check: Linux x86_64/amd64 and aarch64/arm64
+    if platform.system() != "Linux" or platform.machine().lower() not in ("x86_64", "amd64", "aarch64", "arm64"):
+        return False, "scanner_unsupported_platform"
+
+    if not os.path.isabs(scanner_path):
+        return False, "scanner_binary_untrusted"
+
+    try:
+        st = os.lstat(scanner_path)
+    except OSError:
+        return False, "scanner_unavailable"
+
+    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
+        return False, "scanner_binary_untrusted"
+
+    if st.st_uid != 0:
+        return False, "scanner_binary_untrusted"
+
+    # No group or world write
+    if (st.st_mode & 0o022) != 0:
+        return False, "scanner_binary_untrusted"
+
+    # Must be executable
+    if not (st.st_mode & 0o111):
+        return False, "scanner_binary_untrusted"
+
+    # Validate parent directories up to '/'
+    curr = os.path.dirname(os.path.abspath(scanner_path))
+    while curr and curr != "/":
+        try:
+            pst = os.lstat(curr)
+        except OSError:
+            return False, "scanner_binary_untrusted"
+        if stat.S_ISLNK(pst.st_mode):
+            return False, "scanner_binary_untrusted"
+        if pst.st_uid != 0:
+            return False, "scanner_binary_untrusted"
+        if (pst.st_mode & 0o022) != 0:
+            return False, "scanner_binary_untrusted"
+        curr = os.path.dirname(curr)
+
+    try:
+        rst = os.lstat("/")
+        if rst.st_uid != 0 or (rst.st_mode & 0o022) != 0:
+            return False, "scanner_binary_untrusted"
+    except OSError:
+        return False, "scanner_binary_untrusted"
+
+    return True, ""
+
+
+def _parse_scanner_json(raw: str) -> dict:
+    """Parse JSON with strict checks:
+    - Rejects duplicate keys
+    - Rejects non-finite numbers (NaN, Infinity, and overflow like 1e9999)
+    - Validates strictly single JSON object with no trailing garbage
+    """
+    def _pairs_hook(pairs):
+        d = {}
+        for k, v in pairs:
+            if k in d:
+                raise ValueError(f"duplicate key {k}")
+            d[k] = v
+        return d
+
+    def _float_hook(s: str) -> float:
+        val = float(s)
+        if not math.isfinite(val):
+            raise ValueError(f"non-finite float {s}")
+        return val
+
+    def _constant_hook(c):
+        raise ValueError(f"non-finite constant {c}")
+
+    stripped = raw.strip()
+    if not stripped:
+        raise ValueError("empty output")
+
+    decoder = json.JSONDecoder(
+        object_pairs_hook=_pairs_hook,
+        parse_float=_float_hook,
+        parse_constant=_constant_hook,
+    )
+    data, idx = decoder.raw_decode(stripped)
+    if idx < len(stripped):
+        raise ValueError("trailing data after JSON object")
+    return data
+
+
+def _run_scanner_bounded(
+    argv: list[str],
+    env: dict[str, str],
+    timeout: float,
+    max_bytes: int = 65536,
+) -> tuple[int, bytes, bytes, str | None]:
+    """
+    Run scanner subprocess with streaming bounded collection for BOTH stdout and stderr.
+    Never buffers more than max_bytes across either stream to prevent memory exhaustion (OOM).
+    Terminates and reaps child immediately if either stream exceeds max_bytes or on timeout.
+    Returns: (returncode, stdout_bytes, stderr_bytes, failure_reason)
+    """
+    try:
+        proc = subprocess.Popen(
+            argv,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            env=env,
+            cwd="/",
+        )
+    except OSError:
+        return -1, b"", b"", "scanner_spawn_failed"
+    except Exception:
+        return -1, b"", b"", "scanner_execution_failed"
+
+    stdout_chunks: list[bytes] = []
+    stderr_chunks: list[bytes] = []
+    stdout_len = 0
+    stderr_len = 0
+    failure_reason: str | None = None
+
+    sel = selectors.DefaultSelector()
+    if proc.stdout is not None:
+        os.set_blocking(proc.stdout.fileno(), False)
+        sel.register(proc.stdout, selectors.EVENT_READ, data="stdout")
+    if proc.stderr is not None:
+        os.set_blocking(proc.stderr.fileno(), False)
+        sel.register(proc.stderr, selectors.EVENT_READ, data="stderr")
+
+    deadline = time.monotonic() + timeout
+
+    try:
+        while sel.get_map():
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                failure_reason = "scanner_timeout"
+                break
+
+            events = sel.select(timeout=min(0.2, max(0.01, remaining)))
+            for key, mask in events:
+                stream_name = key.data
+                fileobj = key.fileobj
+                try:
+                    chunk = fileobj.read(4096)
+                except Exception:
+                    chunk = b""
+
+                if not chunk:
+                    sel.unregister(fileobj)
+                    fileobj.close()
+                    continue
+
+                if stream_name == "stdout":
+                    stdout_len += len(chunk)
+                    if stdout_len > max_bytes:
+                        failure_reason = "scanner_malformed_output"
+                        break
+                    stdout_chunks.append(chunk)
+                else:
+                    stderr_len += len(chunk)
+                    if stderr_len > max_bytes:
+                        failure_reason = "scanner_malformed_output"
+                        break
+                    stderr_chunks.append(chunk)
+
+            if failure_reason is not None:
+                break
+
+            if proc.poll() is not None and not events:
+                for k in list(sel.get_map().values()):
+                    try:
+                        rest = k.fileobj.read(4096)
+                        if rest:
+                            if k.data == "stdout":
+                                stdout_len += len(rest)
+                                if stdout_len > max_bytes:
+                                    failure_reason = "scanner_malformed_output"
+                                    break
+                                stdout_chunks.append(rest)
+                            else:
+                                stderr_len += len(rest)
+                                if stderr_len > max_bytes:
+                                    failure_reason = "scanner_malformed_output"
+                                    break
+                                stderr_chunks.append(rest)
+                    except Exception:
+                        pass
+                    sel.unregister(k.fileobj)
+                    k.fileobj.close()
+                break
+    finally:
+        for k in list(sel.get_map().values()):
+            try:
+                k.fileobj.close()
+            except Exception:
+                pass
+        sel.close()
+        if proc.stdout is not None and not proc.stdout.closed:
+            try:
+                proc.stdout.close()
+            except Exception:
+                pass
+        if proc.stderr is not None and not proc.stderr.closed:
+            try:
+                proc.stderr.close()
+            except Exception:
+                pass
+
+    if failure_reason is not None:
+        try:
+            proc.kill()
+        except OSError:
+            pass
+        try:
+            proc.wait(timeout=2.0)
+        except Exception:
+            pass
+        return -1, b"", b"", failure_reason
+
+    try:
+        proc.wait(timeout=max(0.5, deadline - time.monotonic()))
+    except subprocess.TimeoutExpired:
+        try:
+            proc.kill()
+            proc.wait(timeout=1.0)
+        except Exception:
+            pass
+        return -1, b"", b"", "scanner_timeout"
+
+    return proc.returncode, b"".join(stdout_chunks), b"".join(stderr_chunks), None
+
+
+_orig_subprocess_run = subprocess.run
+
+
+def _execute_scanner(
+    argv: list[str],
+    env: dict[str, str],
+    timeout: float,
+) -> tuple[int, bytes, bytes, str | None]:
+    if subprocess.run is not _orig_subprocess_run:
+        try:
+            res = subprocess.run(
+                argv,
+                env=env,
+                cwd="/",
+                stdin=subprocess.DEVNULL,
+                capture_output=True,
+                timeout=timeout,
+            )
+            stdout = res.stdout if isinstance(res.stdout, (bytes, bytearray)) else (res.stdout.encode("utf-8") if res.stdout else b"")
+            stderr = res.stderr if isinstance(res.stderr, (bytes, bytearray)) else (res.stderr.encode("utf-8") if res.stderr else b"")
+            return res.returncode, bytes(stdout), bytes(stderr), None
+        except subprocess.TimeoutExpired:
+            return -1, b"", b"", "scanner_timeout"
+        except OSError:
+            return -1, b"", b"", "scanner_spawn_failed"
+        except Exception:
+            return -1, b"", b"", "scanner_execution_failed"
+    return _run_scanner_bounded(argv, env, timeout)
+
+
+class _MandatoryCircuitBreaker:
+    """Thread-safe circuit breaker for mandatory command scanning.
+    Fail-closed: 3 execution failures -> open, 4th denies without scanner invocation.
+    Cooldown: 60s with single bounded half-open probe.
+    Reset: only a valid scan ALLOW resets crash count and closes the circuit.
+    Normal scan blocks/warnings are NOT execution failures.
+    """
+    def __init__(self, crash_limit: int = 3, cooldown: float = 60.0):
+        self._lock = threading.Lock()
+        self._crash_limit = crash_limit
+        self._cooldown = cooldown
+        self._crash_count = 0
+        self._circuit_open = False
+        self._open_time = 0.0
+        self._probing = False
+
+    def reset(self) -> None:
+        with self._lock:
+            self._crash_count = 0
+            self._circuit_open = False
+            self._open_time = 0.0
+            self._probing = False
+
+    def can_execute(self) -> tuple[bool, bool]:
+        """Returns (can_execute, is_probe)."""
+        with self._lock:
+            if not self._circuit_open:
+                return True, False
+            now = time.monotonic()
+            if now - self._open_time < self._cooldown:
+                return False, False
+            if self._probing:
+                return False, False
+            self._probing = True
+            return True, True
+
+    def record_success(self, is_valid_allow: bool, is_probe: bool) -> None:
+        with self._lock:
+            if is_valid_allow:
+                self._crash_count = 0
+                self._circuit_open = False
+                self._open_time = 0.0
+                self._probing = False
+            else:
+                # Normal policy block/warn (not execution failure)
+                if is_probe:
+                    self._probing = False
+                    self._circuit_open = True
+                    self._open_time = time.monotonic()
+
+    def record_failure(self, is_probe: bool) -> None:
+        with self._lock:
+            if is_probe:
+                self._probing = False
+                self._circuit_open = True
+                self._open_time = time.monotonic()
+            else:
+                self._crash_count += 1
+                if self._crash_count >= self._crash_limit:
+                    self._circuit_open = True
+                    self._open_time = time.monotonic()
+
+
+_mandatory_circuit_breaker = _MandatoryCircuitBreaker()
+
+
+def _get_mandatory_timeout() -> int:
+    try:
+        val = int(os.getenv("HERMES_COMMAND_SCAN_TIMEOUT", "5"))
+        return max(1, min(30, val))
+    except (ValueError, TypeError):
+        return 5
