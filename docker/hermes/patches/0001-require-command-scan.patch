+class TestParseScannerJson:
+    def test_parse_valid_json(self):
+        raw = '{"action": "allow", "findings": [], "schema_version": 3}'
+        data = _parse_scanner_json(raw)
+        assert data["action"] == "allow"
+        assert data["findings"] == []
+
+    def test_parse_rejects_duplicate_keys(self):
+        raw = '{"action": "allow", "action": "block"}'
+        with pytest.raises(ValueError, match="duplicate key"):
+            _parse_scanner_json(raw)
+
+    def test_parse_rejects_non_finite_constants(self):
+        raw = '{"val": NaN}'
+        with pytest.raises(ValueError, match="non-finite constant"):
+            _parse_scanner_json(raw)
+
+        raw = '{"val": Infinity}'
+        with pytest.raises(ValueError, match="non-finite constant"):
+            _parse_scanner_json(raw)
+
+    def test_parse_rejects_malformed_json(self):
+        raw = '{"action": "allow", '
+        with pytest.raises(Exception):
+            _parse_scanner_json(raw)
+
