+def _scan_for_require_command_scan_flag(argv: list[str]) -> bool:
+    """Inspect arguments before '--' terminator for --require-command-scan flag."""
+    for token in argv:
+        if token == "--":
+            break
+        if token == "--require-command-scan" or token == "--require-command-scan=1" or token.lower() == "--require-command-scan=true":
+            return True
+    return False
+
