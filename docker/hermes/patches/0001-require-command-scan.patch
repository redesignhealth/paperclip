+class TestMandatoryCircuitBreaker:
+    def test_breaker_opens_after_three_failures(self):
+        cb = _MandatoryCircuitBreaker(crash_limit=3, cooldown=60.0)
+        assert cb.can_execute() == (True, False)
+
+        cb.record_failure(is_probe=False)
+        assert cb.can_execute() == (True, False)
+
+        cb.record_failure(is_probe=False)
+        assert cb.can_execute() == (True, False)
+
+        cb.record_failure(is_probe=False)
+        # Breaker is now open! 4th call is denied without invocation
+        can_run, is_probe = cb.can_execute()
+        assert can_run is False
+        assert is_probe is False
+
+    def test_block_or_warn_not_counted_as_execution_failure(self):
+        cb = _MandatoryCircuitBreaker(crash_limit=3, cooldown=60.0)
+        # Normal scan policy blocks do not increment crash count
+        cb.record_success(is_valid_allow=False, is_probe=False)
+        cb.record_success(is_valid_allow=False, is_probe=False)
+        cb.record_success(is_valid_allow=False, is_probe=False)
+        cb.record_success(is_valid_allow=False, is_probe=False)
+        # Breaker remains closed
+        can_run, _ = cb.can_execute()
+        assert can_run is True
+
+    def test_cooldown_and_single_half_open_probe(self, monkeypatch):
+        cb = _MandatoryCircuitBreaker(crash_limit=3, cooldown=60.0)
+        for _ in range(3):
+            cb.record_failure(is_probe=False)
+
+        # Before cooldown
+        now = 100.0
+        monkeypatch.setattr(time, "monotonic", lambda: now)
+        cb._open_time = now - 30.0
+        assert cb.can_execute() == (False, False)
+
+        # After cooldown (60s)
+        cb._open_time = now - 61.0
+        # First caller gets to probe
+        can_run, is_probe = cb.can_execute()
+        assert can_run is True
+        assert is_probe is True
+
+        # Second caller while probe is in flight is denied
+        can_run_2, is_probe_2 = cb.can_execute()
+        assert can_run_2 is False
+        assert is_probe_2 is False
+
+        # Probe fails -> re-arms cooldown
+        cb.record_failure(is_probe=True)
+        assert cb._circuit_open is True
+        assert cb.can_execute() == (False, False)
+
+        # After another cooldown, probe succeeds with valid ALLOW -> resets breaker
+        cb._open_time = now - 61.0
+        can_run, is_probe = cb.can_execute()
+        assert can_run is True
+        assert is_probe is True
+
+        cb.record_success(is_valid_allow=True, is_probe=True)
+        assert cb._circuit_open is False
+        assert cb._crash_count == 0
+        assert cb.can_execute() == (True, False)
+
