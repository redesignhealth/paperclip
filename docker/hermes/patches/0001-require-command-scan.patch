+def _is_strict_int(val: object) -> bool:
+    """True if val is an int and strictly not a bool."""
+    return type(val) is int and not isinstance(val, bool)
+
+
+def _is_strict_bool(val: object) -> bool:
+    """True if val is strictly a bool."""
+    return type(val) is bool
+
+
+def _validate_finding_item(item: object) -> bool:
+    """Validate that finding dictionary matches Tirith finding schema."""
+    if not isinstance(item, dict):
+        return False
+    required_str_fields = ("rule_id", "severity", "title", "description", "remediation")
+    for f in required_str_fields:
+        if not isinstance(item.get(f), str):
+            return False
+    if not isinstance(item.get("evidence"), list):
+        return False
+    if "mitre_id" in item and item["mitre_id"] is not None and not isinstance(item["mitre_id"], str):
+        return False
+    return True
