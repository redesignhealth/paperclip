+def _parse_scanner_json(raw: str) -> dict:
+    """Parse JSON with strict checks: duplicate keys and non-finite constants are rejected."""
+    def _pairs_hook(pairs):
+        d = {}
+        for k, v in pairs:
+            if k in d:
+                raise ValueError(f"duplicate key {k}")
+            d[k] = v
+        return d
+
+    def _constant_hook(c):
+        raise ValueError(f"non-finite constant {c}")
+
+    return json.loads(raw, object_pairs_hook=_pairs_hook, parse_constant=_constant_hook)
