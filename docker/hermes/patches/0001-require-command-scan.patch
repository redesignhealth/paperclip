+    def test_schema_violations_denied_as_malformed(self, monkeypatch):
+        from tools import tirith_security
+        mock_proc = MagicMock()
+        mock_proc.returncode = 0
+
+        # Violation 1: bypass_honored is True
+        tirith_security._mandatory_circuit_breaker.reset()
+        mock_proc.stdout = make_mock_tirith_output("allow", [], bypass_honored=True)
+        monkeypatch.setattr(subprocess, "run", lambda *a, **kw: mock_proc)
+        assert check_command_mandatory("ls")["reason"] == "scanner_execution_failed"
+
+        # Violation 2: bypass_requested is True
+        tirith_security._mandatory_circuit_breaker.reset()
+        mock_proc.stdout = make_mock_tirith_output("allow", [], bypass_requested=True)
+        assert check_command_mandatory("ls")["reason"] == "scanner_execution_failed"
+
+        # Violation 3: interactive_detected is True
+        tirith_security._mandatory_circuit_breaker.reset()
+        mock_proc.stdout = make_mock_tirith_output("allow", [], interactive_detected=True)
+        assert check_command_mandatory("ls")["reason"] == "scanner_execution_failed"
+
+        # Violation 4: policy_path_used is not None
+        tirith_security._mandatory_circuit_breaker.reset()
+        mock_proc.stdout = make_mock_tirith_output("allow", [], policy_path_used="/custom/policy.yaml")
+        assert check_command_mandatory("ls")["reason"] == "scanner_malformed_output"
+
+        # Violation 5: schema_version is not 3
+        tirith_security._mandatory_circuit_breaker.reset()
+        mock_proc.stdout = make_mock_tirith_output("allow", [], schema_version=2)
+        assert check_command_mandatory("ls")["reason"] == "scanner_malformed_output"
+
+        # Violation 6: boolean coerced to int in schema_version (e.g. True == 1)
+        tirith_security._mandatory_circuit_breaker.reset()
+        mock_proc.stdout = make_mock_tirith_output("allow", [], schema_version=True)
+        assert check_command_mandatory("ls")["reason"] == "scanner_malformed_output"
+
+        # Violation 7: missing critical key
+        tirith_security._mandatory_circuit_breaker.reset()
+        bad_json = json.dumps({"action": "allow", "schema_version": 3, "findings": []}).encode("utf-8")
+        mock_proc.stdout = bad_json
+        assert check_command_mandatory("ls")["reason"] == "scanner_malformed_output"
