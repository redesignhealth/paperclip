+        return {"allowed": False, "reason": "scanner_malformed_output", "findings": []}
+
+    # Strict typed validation of pinned Tirith 0.4.2 schema
+    schema_ver = data.get("schema_version")
+    if not _is_strict_int(schema_ver) or schema_ver != 3:
+        _mandatory_circuit_breaker.record_failure(is_probe)
+        return {"allowed": False, "reason": "scanner_malformed_output", "findings": []}
+
+    action = data.get("action")
+    if not isinstance(action, str) or action not in ("allow", "block", "warn"):
+        _mandatory_circuit_breaker.record_failure(is_probe)
+        return {"allowed": False, "reason": "scanner_malformed_output", "findings": []}
+
+    raw_findings = data.get("findings")
+    if not isinstance(raw_findings, list) or not all(_validate_finding_item(f) for f in raw_findings):
+        _mandatory_circuit_breaker.record_failure(is_probe)
+        return {"allowed": False, "reason": "scanner_malformed_output", "findings": []}
+    findings = raw_findings
+
+    bypass_req = data.get("bypass_requested")
+    bypass_hon = data.get("bypass_honored")
+    interactive_det = data.get("interactive_detected")
+    policy_path = data.get("policy_path_used")
+    tier_reached = data.get("tier_reached")
+    timings = data.get("timings_ms")
+
+    if (
+        not _is_strict_bool(bypass_req)
+        or not _is_strict_bool(bypass_hon)
+        or not _is_strict_bool(interactive_det)
+        or policy_path is not None
+        or not _is_strict_int(tier_reached)
+        or not isinstance(timings, dict)
+    ):
+        _mandatory_circuit_breaker.record_failure(is_probe)
+        return {"allowed": False, "reason": "scanner_malformed_output", "findings": []}
+
+    if "urls_extracted_count" in data and not _is_strict_int(data["urls_extracted_count"]):
+        _mandatory_circuit_breaker.record_failure(is_probe)
+        return {"allowed": False, "reason": "scanner_malformed_output", "findings": []}
+
+    # Strict ALLOW: exit code 0, action 'allow', no findings, no bypass requested/honored, non-interactive, null policy path
+    if (
+        proc.returncode == 0
+        and action == "allow"
+        and len(findings) == 0
+        and bypass_req is False
+        and bypass_hon is False
+        and interactive_det is False
+        and policy_path is None
+    ):
+        _mandatory_circuit_breaker.record_success(is_valid_allow=True, is_probe=is_probe)
+        return {"allowed": True, "reason": "", "findings": []}
+
+    # Policy block/warn or defer: exit 1 (block), exit 2 (warn), exit 4 (defer)
+    if proc.returncode in (1, 2, 4) or action in ("block", "warn") or len(findings) > 0:
+        _mandatory_circuit_breaker.record_success(is_valid_allow=False, is_probe=is_probe)
+        return {"allowed": False, "reason": "scanner_finding_blocked", "findings": findings}
+
+    # If action was allow but bypass/interactive was triggered, or unexpected exit code -> execution failure
+    _mandatory_circuit_breaker.record_failure(is_probe)
+    return {"allowed": False, "reason": "scanner_execution_failed", "findings": findings}
