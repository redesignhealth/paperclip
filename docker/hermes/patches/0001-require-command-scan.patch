+def check_command_mandatory(command: str) -> dict:
+    """Run mandatory Tirith security scan on a command.
+    Returns: {"allowed": bool, "reason": str, "findings": list}
+    """
+    scanner_path = get_mandatory_scanner_path()
+    valid, reason = _validate_mandatory_scanner(scanner_path)
+    if not valid:
+        return {"allowed": False, "reason": reason, "findings": []}
+
+    can_run, is_probe = _mandatory_circuit_breaker.can_execute()
+    if not can_run:
+        return {"allowed": False, "reason": "scanner_circuit_open", "findings": []}
+
+    cmd_text = str(command)
+    argv = [
+        scanner_path,
+        "check",
+        "--offline",
+        "--json",
+        "--non-interactive",
+        "--shell",
+        "posix",
+        "--",
+        cmd_text,
+    ]
+
+    scan_home = (
+        "/usr/local/share/hermes-command-scan/home"
+        if os.path.isdir("/usr/local/share/hermes-command-scan/home")
+        else ("/opt/scan/home" if os.path.isdir("/opt/scan/home") else "/tmp")
+    )
+
+    env = {
+        "LANG": "C.UTF-8",
+        "PATH": "/usr/bin:/bin",
+        "HOME": scan_home,
+        "XDG_CONFIG_HOME": scan_home,
+        "XDG_DATA_HOME": scan_home,
+        "XDG_CACHE_HOME": scan_home,
+        "XDG_STATE_HOME": scan_home,
+        "XDG_RUNTIME_DIR": scan_home,
+    }
+
+    timeout = _get_mandatory_timeout()
+
+    try:
+        proc = subprocess.run(
+            argv,
+            env=env,
+            cwd="/",
+            stdin=subprocess.DEVNULL,
+            capture_output=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        _mandatory_circuit_breaker.record_failure(is_probe)
+        logger.warning("Mandatory command scanner timed out")
+        return {"allowed": False, "reason": "scanner_timeout", "findings": []}
+    except OSError:
+        _mandatory_circuit_breaker.record_failure(is_probe)
+        logger.warning("Mandatory command scanner spawn failed")
+        return {"allowed": False, "reason": "scanner_spawn_failed", "findings": []}
+    except Exception:
+        _mandatory_circuit_breaker.record_failure(is_probe)
+        logger.warning("Mandatory command scanner execution error")
+        return {"allowed": False, "reason": "scanner_execution_failed", "findings": []}
+
+    stdout_bytes = proc.stdout or b""
+    if len(stdout_bytes) > 65536:
+        _mandatory_circuit_breaker.record_failure(is_probe)
+        logger.warning("Mandatory command scanner output exceeded size limit")
+        return {"allowed": False, "reason": "scanner_malformed_output", "findings": []}
+
+    try:
