+class TestMandatoryScanModeConfig:
+    def test_extension_version_and_marker(self):
+        assert HERMES_SECURITY_EXTENSION_MARKER == "TECH-7355-MANDATORY-COMMAND-SCAN"
+        assert HERMES_RUNTIME_EXTENSION_VERSION.startswith("0.21.3+")
+
+    def test_is_mandatory_scan_mode_truthy_values(self, monkeypatch):
+        for val in ("1", "true", "True", "yes", "YES", "on", "required"):
+            monkeypatch.setenv("HERMES_REQUIRE_COMMAND_SCAN", val)
+            assert is_mandatory_scan_mode() is True
+
+    def test_is_mandatory_scan_mode_falsy_values(self, monkeypatch):
+        for val in ("", "0", "false", "no", "off"):
+            monkeypatch.setenv("HERMES_REQUIRE_COMMAND_SCAN", val)
+            assert is_mandatory_scan_mode() is False
+
+    def test_mandatory_ignores_legacy_tirith_disabled(self, monkeypatch):
+        monkeypatch.setenv("HERMES_REQUIRE_COMMAND_SCAN", "1")
+        monkeypatch.setenv("TIRITH_ENABLED", "0")
+        monkeypatch.setenv("TIRITH_OFF", "1")
+        assert is_mandatory_scan_mode() is True
