+        monkeypatch.setattr(platform, "machine", lambda: "x86_64")
+        valid, reason = _validate_mandatory_scanner("/usr/local/bin/nonexistent_tirith_xyz")
+        assert valid is False
+        assert reason == "scanner_unavailable"
+
+    def test_symlink_rejected(self, monkeypatch):
+        monkeypatch.setattr(platform, "system", lambda: "Linux")
+        monkeypatch.setattr(platform, "machine", lambda: "x86_64")
+        # Mock os.lstat to report S_IFLNK
+        fake_st = MagicMock()
+        fake_st.st_mode = stat.S_IFLNK | 0o755
+        fake_st.st_uid = 0
+        monkeypatch.setattr(os, "lstat", lambda p: fake_st)
+        valid, reason = _validate_mandatory_scanner("/usr/local/bin/tirith")
+        assert valid is False
+        assert reason == "scanner_binary_untrusted"
+
+    def test_non_root_owned_rejected(self, monkeypatch):
+        monkeypatch.setattr(platform, "system", lambda: "Linux")
+        monkeypatch.setattr(platform, "machine", lambda: "x86_64")
+        fake_st = MagicMock()
+        fake_st.st_mode = stat.S_IFREG | 0o755
+        fake_st.st_uid = 1000  # non-root
+        monkeypatch.setattr(os, "lstat", lambda p: fake_st)
+        valid, reason = _validate_mandatory_scanner("/usr/local/bin/tirith")
+        assert valid is False
+        assert reason == "scanner_binary_untrusted"
+
+    def test_group_or_world_writable_rejected(self, monkeypatch):
+        monkeypatch.setattr(platform, "system", lambda: "Linux")
+        monkeypatch.setattr(platform, "machine", lambda: "x86_64")
+        fake_st = MagicMock()
+        fake_st.st_mode = stat.S_IFREG | 0o777  # writable by group and world
+        fake_st.st_uid = 0
+        monkeypatch.setattr(os, "lstat", lambda p: fake_st)
+        valid, reason = _validate_mandatory_scanner("/usr/local/bin/tirith")
+        assert valid is False
+        assert reason == "scanner_binary_untrusted"
+
+    def test_untrusted_parent_directory_rejected(self, monkeypatch):
+        monkeypatch.setattr(platform, "system", lambda: "Linux")
+        monkeypatch.setattr(platform, "machine", lambda: "x86_64")
+
+        def fake_lstat(p):
+            st = MagicMock()
+            if p == "/tmp/tirith":
+                st.st_mode = stat.S_IFREG | 0o755
+                st.st_uid = 0
+            elif p == "/tmp":
+                st.st_mode = stat.S_IFDIR | 0o777  # /tmp is world-writable
+                st.st_uid = 0
+            else:
+                st.st_mode = stat.S_IFDIR | 0o755
+                st.st_uid = 0
+            return st
+
+        monkeypatch.setattr(os, "lstat", fake_lstat)
+        valid, reason = _validate_mandatory_scanner("/tmp/tirith")
+        assert valid is False
+        assert reason == "scanner_binary_untrusted"
+
+    def test_valid_root_binary(self, monkeypatch):
+        monkeypatch.setattr(platform, "system", lambda: "Linux")
+        monkeypatch.setattr(platform, "machine", lambda: "x86_64")
+        fake_st = MagicMock()
+        fake_st.st_mode = stat.S_IFREG | 0o755
+        fake_st.st_uid = 0
+
+        fake_dir_st = MagicMock()
+        fake_dir_st.st_mode = stat.S_IFDIR | 0o755
+        fake_dir_st.st_uid = 0
+
+        def fake_lstat(p):
+            if p == "/usr/local/bin/tirith":
+                return fake_st
+            return fake_dir_st
+
+        monkeypatch.setattr(os, "lstat", fake_lstat)
+        valid, reason = _validate_mandatory_scanner("/usr/local/bin/tirith")
+        assert valid is True
+        assert reason == ""
