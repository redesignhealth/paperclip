+class _MandatoryCircuitBreaker:
+    """Thread-safe circuit breaker for mandatory command scanning.
+    Fail-closed: 3 execution failures -> open, 4th denies without scanner invocation.
+    Cooldown: 60s with single bounded half-open probe.
+    Reset: only a valid scan ALLOW resets crash count and closes the circuit.
+    Normal scan blocks/warnings are NOT execution failures.
+    """
+    def __init__(self, crash_limit: int = 3, cooldown: float = 60.0):
+        self._lock = threading.Lock()
+        self._crash_limit = crash_limit
+        self._cooldown = cooldown
+        self._crash_count = 0
+        self._circuit_open = False
+        self._open_time = 0.0
+        self._probing = False
+
+    def reset(self) -> None:
+        with self._lock:
+            self._crash_count = 0
+            self._circuit_open = False
+            self._open_time = 0.0
+            self._probing = False
+
+    def can_execute(self) -> tuple[bool, bool]:
+        """Returns (can_execute, is_probe)."""
+        with self._lock:
+            if not self._circuit_open:
+                return True, False
+            now = time.monotonic()
+            if now - self._open_time < self._cooldown:
+                return False, False
+            if self._probing:
+                return False, False
+            self._probing = True
+            return True, True
+
+    def record_success(self, is_valid_allow: bool, is_probe: bool) -> None:
+        with self._lock:
+            if is_valid_allow:
+                self._crash_count = 0
+                self._circuit_open = False
+                self._open_time = 0.0
+                self._probing = False
+            else:
+                # Normal policy block/warn (not execution failure)
+                if is_probe:
+                    self._probing = False
+                    self._circuit_open = True
+                    self._open_time = time.monotonic()
+
+    def record_failure(self, is_probe: bool) -> None:
+        with self._lock:
+            if is_probe:
+                self._probing = False
+                self._circuit_open = True
+                self._open_time = time.monotonic()
+            else:
+                self._crash_count += 1
+                if self._crash_count >= self._crash_limit:
+                    self._circuit_open = True
+                    self._open_time = time.monotonic()
+
+
+_mandatory_circuit_breaker = _MandatoryCircuitBreaker()
+
+
