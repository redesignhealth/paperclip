+    def test_unsupported_platform(self, monkeypatch):
+        monkeypatch.setattr(platform, "system", lambda: "Darwin")
+        valid, reason = _validate_mandatory_scanner("/usr/local/bin/tirith")
+        assert valid is False
+        assert reason == "scanner_unsupported_platform"
+
+        monkeypatch.setattr(platform, "system", lambda: "Linux")
+        monkeypatch.setattr(platform, "machine", lambda: "arm64")
+        valid, reason = _validate_mandatory_scanner("/usr/local/bin/tirith")
+        assert valid is False
+        assert reason == "scanner_unsupported_platform"
+
+    def test_relative_path_rejected(self, monkeypatch):
+        monkeypatch.setattr(platform, "system", lambda: "Linux")
+        monkeypatch.setattr(platform, "machine", lambda: "x86_64")
+        valid, reason = _validate_mandatory_scanner("bin/tirith")
+        assert valid is False
+        assert reason == "scanner_binary_untrusted"
+
+    def test_file_not_found(self, monkeypatch):
