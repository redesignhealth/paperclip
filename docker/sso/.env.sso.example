# SSO Docker Compose environment variables
# Copy to .env in the docker/ directory before running docker-compose.sso.yml

# Better Auth secret (any random string, used for session signing).
# Required -- the compose file fails loud if this is unset or empty. Left
# empty here deliberately: a non-empty placeholder would silently bypass
# that guard if this file is copied verbatim. Generate a real value with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# Keycloak admin console: http://localhost:8080
# Keycloak admin credentials: admin / admin
#
# Pre-configured test users in the "paperclip" realm:
#   admin@paperclip.local / admin
#   operator@paperclip.local / operator
#
# Paperclip UI: http://localhost:3100
# Click "Keycloak SSO" on the login page to authenticate via Keycloak.
#
# IMPORTANT: The Keycloak issuer URL in PAPERCLIP_SSO_PROVIDERS must be
# "http://paperclip-keycloak.localtest.me:8080/realms/paperclip", not
# "localhost:8080" or "keycloak:8080". "*.localtest.me" is a public DNS
# record that always resolves to 127.0.0.1, so the browser reaches Keycloak's
# published port with no /etc/hosts edits needed. The server container
# resolves that same hostname straight to Keycloak's container address (see
# docker-compose.sso.yml's extra_hosts) so its own discovery/token requests
# reach Keycloak too. Plain "localhost" can't be used for this: Docker always
# injects its own "127.0.0.1 localhost" entry into the server container's
# /etc/hosts ahead of anything extra_hosts adds, so the server would keep
# resolving "localhost" to itself.
