# Copy to .env.runner-e2e.local. Existing shell variables take precedence.
# Never commit the local file or put these values in fixture source.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
DAYTONA_API_KEY=

# Explicit-only extended-harnesses candidates.
CURSOR_AUTH_TOKEN=
COPILOT_GITHUB_TOKEN=

# Required only for Daytona cells. Use an immutable, anonymously pullable
# digest from the Runner Full-Stack E2E image job or a locally published image.
PAPERCLIP_E2E_DAYTONA_IMAGE=ghcr.io/paperclipai/paperclip-daytona-runner@sha256:REPLACE_ME
# Optional, explicit subscription qualification only. Supply privately at runtime;
# never commit an actual auth.json payload. API-key profiles do not use this value.
# GROK_AUTH_JSON=

# Native Cursor/Pi/Copilot Daytona fixtures additionally require exact executable
# digests from that immutable Linux image (not the local controller binaries).
# PAPERCLIP_E2E_DAYTONA_NODE_SHA256=sha256:REPLACE_ME
# PAPERCLIP_E2E_DAYTONA_RUNNERD_SHA256=sha256:REPLACE_ME

# Explicit-only memory recall and isolation suite (Hermes agent with Mem0).
# Requires external PostgreSQL instance with TLS (sslmode=require) and pgvector installed in template1.
# Provisions and drops one isolated tenant database per cell. Real provider spend (OpenRouter + OpenAI).
# PAPERCLIP_MEMORY_TENANT_ISOLATION_ENABLED=true
# PAPERCLIP_MEMORY_COMPANY_SCOPE=all
# PAPERCLIP_MEMORY_ADMIN_DATABASE_URL=postgresql://user:pass@host:5432/postgres?sslmode=require
# PAPERCLIP_E2E_MEMORY_HERMES_MODEL=anthropic/claude-3.5-sonnet
# Optional memory hardening flags (default off). Available on this branch: hermes-memory-config, hermes-prompt-split.
# Blocked pending implementation: agent-scoped-mem0 (TECH-8191), capability-memory-guidance (TECH-8192).
# PAPERCLIP_MEMORY_HARDENING=
